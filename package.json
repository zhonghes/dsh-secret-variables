{
  "name": "@local/dsh-secret-variables",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoped secret variables: values stay out of prompts and logs, the model uses them as $DSH_SECRET_* in shell.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "zhonghes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhonghes/dsh-secret-variables.git"
  },
  "homepage": "https://github.com/zhonghes/dsh-secret-variables#readme",
  "bugs": {
    "url": "https://github.com/zhonghes/dsh-secret-variables/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
